{
  "info": {"name": "Lemon Login Demo", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [
    {"key": "baseUrl", "value": "https://demo.invalid/api"},
    {"key": "demoEmail", "value": "demo.user@example.test"},
    {"key": "demoPassword", "value": "${DEMO_PASSWORD}"}
  ],
  "item": [
    {
      "name": "正常登录",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"email\":\"{{demoEmail}}\",\"password\":\"{{demoPassword}}\"}"},
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('status is 200', function () { pm.response.to.have.status(200); });", "pm.test('has accessToken', function () { pm.expect(pm.response.json()).to.have.property('accessToken'); });"]}}],
      "response": [{"name": "success", "code": 200, "body": "{\"accessToken\":\"${ACCESS_TOKEN}\"}"}]
    },
    {
      "name": "错误密码",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"email\":\"{{demoEmail}}\",\"password\":\"wrong-demo-password\"}"},
        "url": "{{baseUrl}}/auth/login"
      },
      "response": [{"name": "unauthorized", "code": 401, "body": "{\"message\":\"authentication failed\"}"}]
    }
  ]
}
